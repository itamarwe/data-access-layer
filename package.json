{
  "name": "dal-context-graph",
  "version": "0.3.0",
  "description": "Install the DAL context graph skill and its isolated CLI runtime",
  "license": "MIT",
  "repository": "github:itamarwe/data-access-layer",
  "engines": { "node": ">=20" },
  "bin": { "dal-context-graph": "installer/cli.mjs" },
  "files": ["installer/*.mjs", "installer/uv.json", "skills/dal/**", "dal/**/*.py", "dal/api/static/**", "pyproject.toml", "examples/shop/semantic/**"],
  "scripts": {
    "test:installer": "node --test installer/test/*.test.mjs",
    "test:install": "node installer/test/smoke.mjs",
    "benchmark": "python -m evals.context_graph.benchmark",
    "build": "npm --prefix web run build",
    "dev": "python -m dal.cli --repository examples/shop serve"
  }
}
